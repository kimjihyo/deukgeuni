# 득근이 봇 설정. 서버에서 /etc/deukgeuni/bot.env 로 복사해 값을 채운다 (chmod 600). git에 올리지 않는다.

# 텔레그램 (BotFather에서 받은 토큰)
TELEGRAM_BOT_TOKEN=
# 웹훅 비밀값: 영문·숫자·_- 만, 예) openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=
# 내 도메인의 봇 주소 (https, 경로 없이)
PUBLIC_URL=https://bot.example.com
LISTEN_HOST=127.0.0.1
LISTEN_PORT=8080
# 쓸 수 있는 사람 (텔레그램 숫자 ID, 쉼표 구분). 봇에게 /whoami 보내면 나옴
ALLOWED_TELEGRAM_IDS=

# LLM: anthropic | openai
LLM_PROVIDER=anthropic
# 비우면 anthropic 기본 모델. openai는 반드시 지정
LLM_MODEL=
LLM_MAX_TOKENS=1500
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# MongoDB Atlas 연결 문자열 (Database → Connect → Drivers)
WL_MONGO_URI=
WL_MONGO_DB=deukgeuni

# 대화 맥락으로 남길 최근 메시지 수, 도구 호출 최대 반복
HISTORY_TURNS=20
MAX_TOOL_ROUNDS=10
TIMEZONE=Asia/Seoul
